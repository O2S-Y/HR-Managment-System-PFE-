@startuml Sequence_Authentification
/'
  NewDEV RH — Diagramme de séquence
  Flux : Authentification JWT (connexion)
  Architecture MVC : Vue (React) → Contrôleur → Modèle (DB)
'/

title Diagramme de séquence — Authentification

actor "Utilisateur" as USER
participant "Vue\n(React)" as VIEW
participant "Contrôleur\n(AuthController)" as CTRL
participant "Modèle\n(UserService)" as MODEL
database "MySQL" as DB

USER -> VIEW : Saisir email + mot de passe
activate VIEW

VIEW -> CTRL : POST /api/auth/login\n{email, password}
activate CTRL

CTRL -> MODEL : authentifier(email, password)
activate MODEL

MODEL -> DB : Chercher utilisateur par email
activate DB

alt Utilisateur trouvé et mot de passe valide
  DB --> MODEL : Utilisateur (id, rôle)
  deactivate DB

  MODEL -> MODEL : Générer token JWT
  MODEL --> CTRL : {token, rôle}
  deactivate MODEL

  CTRL --> VIEW : 200 OK {token, rôle}
  deactivate CTRL

  VIEW -> VIEW : Stocker le JWT\ndans localStorage
  VIEW --> USER : Rediriger vers /dashboard
  deactivate VIEW

else Identifiants invalides
  DB --> MODEL : Non trouvé / mot de passe incorrect
  deactivate DB

  MODEL --> CTRL : Erreur d'authentification
  deactivate MODEL

  CTRL --> VIEW : 401 Unauthorized
  deactivate CTRL

  VIEW --> USER : Afficher message d'erreur
  deactivate VIEW
end

@enduml
