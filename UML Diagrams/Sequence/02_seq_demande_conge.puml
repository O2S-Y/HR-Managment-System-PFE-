@startuml Sequence_Demande_Conge
/'
  NewDEV RH — Diagramme de séquence
  Flux : Soumission d'une demande de congé par un employé
  Architecture MVC : Vue (React) → Contrôleur → Modèle (DB)
'/

title Diagramme de séquence — Demande de congé

actor "Employé" as EMP
participant "Vue\n(React)" as VIEW
participant "Contrôleur\n(LeaveController)" as CTRL
participant "Modèle\n(LeaveService)" as MODEL
database "MySQL" as DB

EMP -> VIEW : Remplir le formulaire\n(type, dates, commentaire)
activate VIEW

VIEW -> CTRL : POST /api/leaves\n{typeId, dateDebut, dateFin}\nAuthorization: Bearer <JWT>
activate CTRL

CTRL -> MODEL : créerDemande(employéId, dto)
activate MODEL

MODEL -> MODEL : Vérifier les dates\net calculer jours ouvrables

MODEL -> DB : Vérifier le solde de congés
activate DB
DB --> MODEL : Solde disponible
deactivate DB

alt Solde suffisant
  MODEL -> DB : Enregistrer la demande\n(statut = EN_ATTENTE)
  activate DB
  DB --> MODEL : Demande créée
  deactivate DB

  MODEL --> CTRL : DemandeDTO
  deactivate MODEL

  CTRL --> VIEW : 201 Created
  deactivate CTRL

  VIEW --> EMP : Confirmation :\n« Demande soumise »
  deactivate VIEW

else Solde insuffisant
  MODEL --> CTRL : Erreur solde insuffisant
  deactivate MODEL

  CTRL --> VIEW : 400 Bad Request
  deactivate CTRL

  VIEW --> EMP : Afficher erreur :\n« Solde insuffisant »
  deactivate VIEW
end

@enduml
