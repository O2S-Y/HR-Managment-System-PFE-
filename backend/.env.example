# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Port
PORT=8080

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/newdev_rh?useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JWT Configuration
# Must be at least 256 bits (32 characters)
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Owner Recovery Key
RECOVERY_KEY=your_secure_recovery_key_here

# Hibernate Settings (Use 'validate' or 'none' in production)
HIBERNATE_DDL_AUTO=update
HIBERNATE_SHOW_SQL=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173
